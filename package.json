{
  "name": "china-scenic-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "China Scenic Map - 中国景点地图（全国省 / 市 / 区县逐级下钻）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "geo:build": "node tools/build-national.mjs",
    "data:pbf": "node tools/extract-osm-pbf.mjs",
    "data:pbf:download": "curl -L -o tmpdata/osm/china-latest.osm.pbf https://download.geofabrik.de/asia/china-latest.osm.pbf",
    "data:build": "node tools/build-attractions.mjs",
    "smoke": "node tools/smoke-test.mjs",
    "data:province": "node tools/fetch-provincial-a-level.mjs",
    "data:findlist": "node tools/find-a-nav.mjs",
    "data:region": "node tools/fetch-region-info.mjs",
    "data:region:build": "node tools/build-regions.mjs",
    "data:intro": "node tools/fetch-region-intro-full.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "osm-pbf-parser": "^2.3.0",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  }
}
